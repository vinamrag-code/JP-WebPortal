<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="JP WebPortal"
            android:textColor="#e8e9f0"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8b8fa3"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_alldone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No more classes today"
        android:textColor="#8b8fa3"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_active_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_active_bg"
        android:padding="10dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_section_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#c8bfff"
            android:textSize="9.5sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_active_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#f2f2f7"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_active_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8b8fa3"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_up_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_up_name1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#e8e9f0"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_up_time1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8b8fa3"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_up_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_up_name2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#e8e9f0"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_up_time2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8b8fa3"
            android:textSize="10.5sp" />
    </LinearLayout>

</LinearLayout>
