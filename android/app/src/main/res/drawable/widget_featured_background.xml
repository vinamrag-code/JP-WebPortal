<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the Nocturne design's active-class card: accent fill/border at 14%/35% alpha
     (accent #9184d9), painted over the widget's opaque dark background so the alpha blend reads
     the same as the design's color-mix(in srgb, accent N%, transparent). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#249184D9" />
    <stroke android:width="1dp" android:color="#599184D9" />
    <corners android:radius="14dp" />
</shape>
